{
	auto_https off
	admin off
}

:8080 {
	root * /srv

	handle_path /api/* {
		encode zstd gzip {
			match header Content-Type application/json*
		}
		request_body {
			max_size 1MB
		}
		reverse_proxy {
			dynamic a {
				name {$BACKEND_HOST:backend}
				port 8000
				refresh 5s
			}
			lb_policy round_robin
			fail_duration 10s
			lb_try_duration 5s
			header_up X-Request-ID {http.request.uuid}
		}
	}

	handle /assets/* {
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		encode zstd gzip
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
