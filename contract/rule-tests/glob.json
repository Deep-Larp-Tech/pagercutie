      "op": "glob",
      "field": "payload.service",
      "value": "pricing-engine-*"
    },
    "event": {
      "source": "payments-webhook",
      "schema_id": "0195f3a0-0000-7000-8000-000000000001",
      "severity": "warn",
      "payload": {
        "amount": 1500000,
        "price": 99.5,
        "currency": "USD",
        "zero": 0,
        "flag": true,
        "off": false,
        "nothing": null,
        "count_str": "5",
        "tags": [
          "urgent",
          "fx",
          3,
          true
