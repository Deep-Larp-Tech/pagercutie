          "title": "Approval"
        },
        "action": {
          "const": "wait",
          "title": "Action",
          "type": "string"
        },
        "seconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Seconds",
          "type": "integer"
        }
      },
      "required": [
        "action",
        "seconds"
      ],
      "title": "Wait",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The `structured` format: the brief's YAML document (REQUIREMENTS \u00a76.2), exported as runbook.schema.json.",
  "properties": {
    "runbook": {
      "maxLength": 50,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Runbook",
      "type": "string"
    },
    "matches": {
      "description": "Payload fields that must be equal; becomes an `and` of `eq` conditions",
      "patternProperties": {
        "^[A-Za-z_]\\w*(\\.\\w+)*$": {
          "$ref": "#/$defs/Scalar"
        }
      },
      "propertyNames": {
        "maxLength": 200
      },
      "title": "Matches",
      "type": "object"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "runbook",
    "steps"
  ],
  "title": "StructuredRunbook",
  "type": "object"
}
