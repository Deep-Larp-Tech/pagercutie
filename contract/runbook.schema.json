    "Scalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "Step": {
      "discriminator": {
        "mapping": {
          "call_webhook": "#/$defs/CallWebhook",
          "escalate": "#/$defs/Escalate",
          "http_get": "#/$defs/HttpGet",
          "manual": "#/$defs/Manual",
          "open_ticket": "#/$defs/OpenTicket",
          "restart_service": "#/$defs/RestartService",
          "retry_workflow": "#/$defs/RetryWorkflow",
          "wait": "#/$defs/Wait"
        },
        "propertyName": "action"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/HttpGet"
        },
        {
          "$ref": "#/$defs/RetryWorkflow"
        },
        {
          "$ref": "#/$defs/RestartService"
        },
        {
          "$ref": "#/$defs/CallWebhook"
        },
        {
          "$ref": "#/$defs/OpenTicket"
        },
        {
          "$ref": "#/$defs/Escalate"
        },
        {
          "$ref": "#/$defs/Wait"
        },
        {
          "$ref": "#/$defs/Manual"
        }
      ]
    },
    "StepGuard": {
      "additionalProperties": false,
      "description": "Run the step only once step `step` (index) has failed at least `failures_gte` times.",
      "properties": {
        "step": {
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "failures_gte": {
          "minimum": 1,
          "title": "Failures Gte",
          "type": "integer"
        }
      },
      "required": [
        "step",
        "failures_gte"
      ],
      "title": "StepGuard",
      "type": "object"
    },
    "Wait": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[^\\x00]*$",
              "type": "string"
            },
            {
              "type": "null"
