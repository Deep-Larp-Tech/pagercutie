{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CallWebhook": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[^\\x00]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Question shown to humans, e.g. 'Is X healthy?'",
          "title": "Check"
        },
        "if": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepGuard"
            },
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "^[^\\x00]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Structured guard, or free text that a human answers yes/no when it cannot be parsed",
          "title": "If"
        },
        "approval": {
          "anyOf": [
            {
              "enum": [
                "none",
                "required"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "null: the action's default; a runbook may only make it stricter",
          "title": "Approval"
        },
        "action": {
          "const": "call_webhook",
          "title": "Action",
          "type": "string"
        },
        "url": {
          "description": "Text with {{field.path}} placeholders rendered from the event payload",
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "^[^\\x00]*$",
          "title": "Url",
          "type": "string"
        },
        "method": {
          "default": "POST",
          "enum": [
            "GET",
            "POST",
            "PUT"
          ],
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "action",
        "url"
      ],
      "title": "CallWebhook",
      "type": "object"
    },
