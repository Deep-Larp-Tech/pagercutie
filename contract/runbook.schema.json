              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "null: the action's default; a runbook may only make it stricter",
          "title": "Approval"
        },
        "action": {
          "const": "escalate",
          "title": "Action",
          "type": "string"
        },
        "team": {
          "maxLength": 50,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Team",
          "type": "string"
        }
      },
      "required": [
        "action",
        "team"
      ],
      "title": "Escalate",
      "type": "object"
    },
