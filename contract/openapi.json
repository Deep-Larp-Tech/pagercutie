    "/imports/larp-events": {
      "post": {
        "tags": [
          "imports"
        ],
        "summary": "Import Larp Events",
        "description": "Create LARPing events from a JSON or CSV file, creating missing persons and skills on the way.\n\nStreams progress events, then exactly one `completed` (sent after commit) or `failed` (nothing imported).\nDisconnecting before the import is committed rolls it back. A stream that ends without `completed` or `failed`\n(connection lost) has an unknown outcome: the commit may have happened just before the drop.",
        "operationId": "import_larp_events",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_import_larp_events"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string",
                      "contentMediaType": "application/json",
                      "contentSchema": {
                        "oneOf": [
                          {
                            "$ref": "#/components/schemas/ImportProgress"
                          },
                          {
                            "$ref": "#/components/schemas/ImportCompleted"
                          },
                          {
                            "$ref": "#/components/schemas/ImportFailed"
                          }
                        ],
                        "discriminator": {
                          "propertyName": "type",
                          "mapping": {
                            "progress": "#/components/schemas/ImportProgress",
                            "completed": "#/components/schemas/ImportCompleted",
                            "failed": "#/components/schemas/ImportFailed"
                          }
                        },
                        "title": "Streamitem Import Larp Events"
                      }
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRead"
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRead"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_import_larp_events": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_import_larp_events"
      },
      "ErrorRead": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorRead"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthRead": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "database": {
            "type": "string",
            "const": "ok",
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "HealthRead"
      },
      "ImportCompleted": {
        "properties": {
          "type": {
            "type": "string",
            "const": "completed",
            "title": "Type",
            "default": "completed"
          },
          "summary": {
            "$ref": "#/components/schemas/ImportSummaryRead"
          }
        },
        "type": "object",
        "required": [
          "summary"
        ],
        "title": "ImportCompleted",
        "description": "Sent only after the import is committed."
      },
      "ImportErrorDetail": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "msg": {
            "type": "string",
            "title": "Msg"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ImportErrorDetail"
      },
      "ImportFailed": {
        "properties": {
          "type": {
            "type": "string",
            "const": "failed",
            "title": "Type",
            "default": "failed"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "$ref": "#/components/schemas/ImportErrorDetail"
                },
                "type": "array"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "status",
          "detail"
        ],
        "title": "ImportFailed",
